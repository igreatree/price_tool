generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseType {
  fixed
  percent
}

enum RuleConditionMode {
  builder
  raw
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  brand      String   @default("")
  cost       Float    @default(0)
  extra      Json     @default("{}")
  updatedAt  DateTime @updatedAt

  supplierPrices           SupplierPrice[]
  marketplaceProductParams MarketplaceProductParams[]
  calculatedPrices         CalculatedPrice[]
}

model SupplierPrice {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierName String
  price        Float
  /**
   * Остаток товара у этого поставщика.
   */
  count        Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([productId])
}

model Expense {
  id           String      @id @default(cuid())
  name         String
  type         ExpenseType
  value        Float
  appliesToAll Boolean     @default(false)
  productIds   String[]    @default([])
}

model Marketplace {
  id                 String   @id @default(cuid())
  name               String
  rounding           Json
  minPriceFormula    String   @default("")
  maxPriceFormula    String   @default("")
  excludedProductIds String[] @default([])
  exclusionCondition String   @default("")
  /**
   * JS-скрипт, вычисляющий стартовую цену товара (обязателен явный return числа). Видит базовый
   * контекст: cost, brand, name, externalId, ...extra, bestSupplierPrice, supplierPricesCount,
   * supplierPrice("Поставщик"), supplierData (массив [{name, price, count}, ...] по всем
   * поставщикам — count это остаток у поставщика), expensesTotal, а также discount/taxRate/
   * commissionRate/logistics/ads/otherExpenses из MarketplaceProductParams. Пример:
   * return brand.toLowerCase().includes("wella") ? supplierPrice("Поставщик1") : cost;
   */
  startPriceScript   String   @default("return cost;")
  /**
   * Основная JS-формула, вычисляющая итоговую цену из стартовой цены (startPrice) и переменных
   * (возможно изменённых правилами в каскаде). Обязателен явный return числа. Пример:
   * return startPrice / (1 - commissionRate) + logistics + ads + otherExpenses;
   */
  priceFormulaScript String   @default("return startPrice;")
  createdAt          DateTime @default(now())

  rules                    Rule[]
  countRules               CountRule[]
  marketplaceProductParams MarketplaceProductParams[]
  calculatedPrices         CalculatedPrice[]
}

model Rule {
  id             String            @id @default(cuid())
  marketplaceId  String
  marketplace    Marketplace       @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  name           String
  priority       Int               @default(0)
  enabled        Boolean           @default(true)
  conditionMode  RuleConditionMode @default(builder)
  conditionGroup Json
  rawCondition   String            @default("")
  /**
   * JS-скрипт действия: выполняется как набор операторов (не обёрнут в функцию с return), поэтому
   * простое присваивание вида commissionRate = commissionRate + 0.05; изменяет переменную в общем
   * контексте расчёта. Видит startPrice и discount/taxRate/commissionRate/logistics/ads/
   * otherExpenses — их можно менять; можно и завести новую переменную для использования в
   * priceFormulaScript. Локальные let/const переменными контекста не становятся.
   */
  actionScript   String            @default("")
  /**
   * Если false — при совпадении условия каскад не останавливается на этом правиле, а продолжает
   * искать следующее подходящее правило (по возрастанию приоритета), сохраняя изменения переменных,
   * сделанные этим правилом. Так правила можно каскадировать. Если true — это правило финализирует
   * состояние переменных перед вычислением priceFormulaScript.
   */
  isFinal        Boolean           @default(true)
  /**
   * Расписание автовкл/выкл по дням недели, напр. {"fri":{"action":"enable","time":"18:00"},
   * "mon":{"action":"disable","time":"00:00"}}. День, отсутствующий в объекте (или null), не
   * управляется расписанием — enabled меняется только вручную. См. RuleSchedulerService.
   */
  schedule       Json              @default("{}")
  createdAt      DateTime          @default(now())

  @@index([marketplaceId])
}

model CountRule {
  id             String            @id @default(cuid())
  marketplaceId  String
  marketplace    Marketplace       @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  name           String
  priority       Int               @default(0)
  enabled        Boolean           @default(true)
  conditionMode  RuleConditionMode @default(builder)
  conditionGroup Json
  rawCondition   String            @default("")
  /**
   * JS-скрипт: обязателен явный return числа — остаток товара, если условие подошло. Видит тот же
   * базовый контекст, что и правила цен (cost, brand, ..., supplierData, ...), а также prevCount —
   * результат предыдущего неполного правила в цепочке (0, если это первое сработавшее правило).
   */
  script         String            @default("return prevCount;")
  /**
   * Если false — при совпадении условия каскад не останавливается на этом правиле, а продолжает
   * искать следующее подходящее правило (по возрастанию приоритета), передавая ему результат этого
   * правила через prevCount.
   */
  isFinal        Boolean           @default(true)
  createdAt      DateTime          @default(now())

  @@index([marketplaceId])
}

model MarketplaceProductParams {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceId  String
  marketplace    Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  discount       Float       @default(0)
  taxRate        Float       @default(0)
  commissionRate Float       @default(0)
  logistics      Float       @default(0)
  ads            Float       @default(0)
  otherExpenses  Float       @default(0)
  updatedAt      DateTime    @updatedAt

  @@unique([productId, marketplaceId])
  @@index([marketplaceId])
}

model CalculatedPrice {
  id                  String      @id @default(cuid())
  productId           String
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceId       String
  marketplace         Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  price               Float
  netProceeds         Float
  marginRatio         Float
  appliedRuleId       String?
  /**
   * Вся цепочка применённых правил по порядку (для каскадных правил — несколько id, иначе один).
   */
  appliedRuleIds      String[]    @default([])
  calculatedAt        DateTime    @default(now())
  warnings            String[]    @default([])
  /**
   * Остаток товара — считается независимо от цены, каскадом «Правил остатков» (см. CountRule).
   */
  count               Int         @default(0)
  appliedCountRuleId  String?
  appliedCountRuleIds String[]    @default([])
  countWarnings       String[]    @default([])
  countCalculatedAt   DateTime?

  @@unique([productId, marketplaceId])
  @@index([marketplaceId])
}
