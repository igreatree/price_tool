# Local (non-docker) development only. Copy to .env and adjust.
DATABASE_URL=postgresql://dev:dev@localhost:55432/price_tool
JWT_SECRET=dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
PORT=3000

# Origin(s) allowed to call this API with cookies, comma-separated.
# Only needed if the frontend talks to this API directly (not through the Vite dev proxy).
CORS_ORIGIN=http://localhost:5173
