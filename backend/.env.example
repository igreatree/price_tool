# Local (non-docker) development only. Copy to .env and adjust.
DATABASE_URL=postgresql://dev:dev@localhost:55432/price_tool
JWT_SECRET=dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
PORT=3000

# Origin(s) allowed to call this API with cookies, comma-separated.
# Only needed if the frontend talks to this API directly (not through the Vite dev proxy).
CORS_ORIGIN=http://localhost:5173

# Timezone the per-rule enable/disable schedule's day/time is interpreted in (IANA name).
# Defaults to UTC if unset — set this to your local timezone, e.g. Europe/Moscow, Asia/Tashkent.
SCHEDULER_TIMEZONE=UTC

# Telegram notifications when a rule's schedule auto-enables/disables it (see rule "Расписание
# автовкл/выкл" in the rule form) and the resulting price recalc finishes.
# Leave blank to disable — no messages are sent if TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID is empty.
TELEGRAM_BOT_TOKEN=
# Chat id, e.g. -1001234567890 for a supergroup.
TELEGRAM_CHAT_ID=
# Optional: message thread (topic) id within that chat/supergroup.
TELEGRAM_TOPIC_ID=
