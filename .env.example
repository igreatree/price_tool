# Domain this stack is served on. DNS must already point here.
DOMAIN=price.bagini.shop

# Email used for Let's Encrypt certificate registration/renewal notices.
ACME_EMAIL=you@example.com

# Postgres credentials (internal network only, never exposed publicly).
POSTGRES_USER=price_tool
POSTGRES_PASSWORD=change-me
POSTGRES_DB=price_tool

# Secret used to sign login session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=change-me

# Single admin account seeded on backend startup (idempotent upsert).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
